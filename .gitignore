# Vendored original source: the 350MB decoded WAV is a build artifact, not
# source (MAIN/MUSIC0.S3M is the real thing). Never commit it.
original/MAIN/MUSIC0.S3M.wav

# The previous soundtrack (archive.org mastered rip), kept only as a fallback.
# assets/music/soundtrack.ogg is now rendered from reference/music/*.s3m by
# tool/render_soundtrack.py — regenerate rather than commit this 12MB backup.
reference/music/soundtrack_mastered.ogg
